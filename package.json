{
  "name": "digital-lab-notebook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "cms": "node tools/cms/server.js",
    "dev": "vite",
    "build": "node scripts/validate.js && node scripts/generate-manifest.js && node scripts/generate-sitemap.js && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
